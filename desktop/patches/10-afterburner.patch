+// Virtual After Burner mechanics for emulator/bench use only. Rates are chosen
+// to exercise Sega's feedback loop, not measured physical actuator dynamics.
+uint8_t segaxbd_state::aburner2_limits() const
+{
+ uint8_t data=0; // 0=open/untripped; 1=closed endpoint, as tested by the ROM.
+ if(m_ab_position[0]<=16.0)data|=0x08;
+ if(m_ab_position[0]>=239.0)data|=0x20;
+ if(m_ab_position[1]<=16.0)data|=0x01;
+ if(m_ab_position[1]>=239.0)data|=0x04;
+ return data;
+}
