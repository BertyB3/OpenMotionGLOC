+void segaxbd_state::aburner2_motion_tick()
+{
+ for(int i=0;i<2;i++) {
+  const int velocity=((m_ab_native>>(i*4))&15)-8;
+  m_ab_position[i]=std::max(0.0,std::min(255.0,m_ab_position[i]+velocity*1.5));
+ }
+ machine().output().set_value("ab_native_motor",m_ab_native);
+ machine().output().set_value("ab_bank_feedback",int(m_ab_position[0]));
+ machine().output().set_value("ab_pitch_feedback",int(m_ab_position[1]));
+ machine().output().set_value("ab_limits",aburner2_limits());
+}
 
