+
+// Open Motion G-Loc Space Harrier v0.1. Historical 8751 HLE expanded
+// with virtual analogue motor feedback. No genuine MCU ROM is substituted.
+void segahang_state::sharrierglc_map(address_map &map)
+{
+ sharrier_map(map);
+ map(0x160001,0x160001).w(FUNC(segahang_state::shlab_gloc_w));
+}
+void segahang_state::shlab_native_w(uint8_t data)
+{
+ m_shlab_native=data;
+ output().set_value("sharrier_native_motor",data);
+}
+uint8_t segahang_state::shlab_limits_r()
+{
+ unsigned v=63;
+ if(m_shlab_pos[1]<=16)v&=~1; if(m_shlab_pos[1]>=240)v&=~4;
+ if(m_shlab_pos[0]<=16)v&=~8; if(m_shlab_pos[0]>=240)v&=~32;
+ if(m_shlab_pos[1]>=125&&m_shlab_pos[1]<=131)v&=~2;
+ if(m_shlab_pos[0]>=125&&m_shlab_pos[0]<=131)v&=~16;
+ return v | (m_adc->intr_r()<<6);
+}
+INTERRUPT_GEN_MEMBER(segahang_state::shlab_vblank)
+{
+ for(int i=0;i<2;i++) {
+  int n=(m_shlab_native>>(i*4))&15;
+  if(n&&n!=8)m_shlab_pos[i]+=0.75*(n-8);
+  if(m_shlab_pos[i]<16)m_shlab_pos[i]=16;
+  if(m_shlab_pos[i]>240)m_shlab_pos[i]=240;
+ }
+ m_workram[0x492/2]=(ioport("ADC0")->read()<<8)|ioport("ADC1")->read();
+ m_workram[0x494/2]=0x8080;
+ m_workram[0x496/2]=(uint8_t(m_shlab_pos[0]+0.5)<<8)|uint8_t(m_shlab_pos[1]+0.5);
+ output().set_value("sharrier_bank_feedback",uint8_t(m_shlab_pos[0]+0.5));
+ output().set_value("sharrier_pitch_feedback",uint8_t(m_shlab_pos[1]+0.5));
+ output().set_value("sharrier_switches",shlab_limits_r()&63);
+ m_maincpu->set_input_line(4,HOLD_LINE);
+}
+void segahang_state::shlab_gloc_w(uint8_t data)
+{
+ output().set_value("gloc_command",data);
+ const unsigned v=data&63;
+ const bool q=data&64;
+ if(data>127)return;
+ if(v>=2&&v<=30) {
+  output().set_value(q?"left_motor_position":"right_motor_position",data);
+  output().set_value(q?"left_motor_position_nor":"right_motor_position_nor",v);
+  output().set_value(q?"gloc_q_target":"gloc_r_target",32-v);
+ } else if(v>=34&&v<=39) output().set_value(q?"left_motor_speed":"right_motor_speed",v-32);
+}
+void segahang_state::sharrierglc(machine_config &config)
+{
+ sharrier_base(config);
+ sound_board_2203(config);
+ m_shlab=true;
+ m_maincpu->set_addrmap(AS_PROGRAM,&segahang_state::sharrierglc_map);
+ m_maincpu->set_vblank_int("screen",FUNC(segahang_state::shlab_vblank));
+ m_i8255[1]->out_pb_callback().set(FUNC(segahang_state::shlab_native_w));
+ m_i8255[1]->in_pc_callback().set(FUNC(segahang_state::shlab_limits_r));
+}
