+
+void segaybd_state::gforce2_gloc_neutral()
+{
+	m_right_motor_position = 0x10;
+	m_left_motor_position = 0x50;
+	m_right_motor_position_nor = 16;
+	m_left_motor_position_nor = 16;
+	m_right_motor_speed = 0;
+	m_left_motor_speed = 0;
+}
+
+INPUT_CHANGED_MEMBER(segaybd_state::gforce2_gloc_enable_changed)
+{
+	// Clear previous targets on either edge of the development switch.
+	gforce2_gloc_neutral();
+}
+
+void segaybd_state::gforce2_gloc_output_cb1(uint16_t data)
+{
+	// Native Galaxy Force commands overlap the G-LOC command ranges.
+	// Enable only when a converted ROM emits the G-LOC byte protocol.
+	if (!(ioport("GLOCMOTION")->read() & 1))
+	{
+		gforce2_gloc_neutral();
+		return;
+	}
+
+	// Preserve upstream raw/normalised positions, speeds and filtering.
+	gloc_output_cb1(data & 0xff);
 }
 
 
